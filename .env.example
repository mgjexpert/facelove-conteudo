# Num ficheiro .env local, colocar o link completo entre aspas para preservar #.
# Production: per-album sources are in Supabase. This is only a local fallback.
MEGA_FOLDER_URL=
SUPABASE_URL=https://uwsuavbskwankqchqkcu.supabase.co
# Current secret key from Settings > API Keys (server only, recommended).
SUPABASE_SECRET_KEY=
# Legacy service_role JWT alternative, only if no secret key is available.
SUPABASE_SERVICE_ROLE_KEY=
# Estes IDs só são necessários para gerar um manifest manual no laboratório.
MEGA_PHOTOS_FOLDER_ID=
MEGA_VIDEOS_FOLDER_ID=
MEDIA_GATEWAY_TOKEN=
# Opcional: executar o gateway local com um manifest manual em vez da descoberta automática.
MEDIA_MANIFEST_PATH=
MEDIA_GATEWAY_HOST=127.0.0.1
MEDIA_GATEWAY_PORT=4100
